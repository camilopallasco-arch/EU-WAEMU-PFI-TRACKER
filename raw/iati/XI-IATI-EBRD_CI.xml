<iati-activity xmlns:dstore="http://d-portal.org/xmlns/dstore" dstore:dataset="ebrd-activity" dstore:index="2741" default-currency="EUR" hierarchy="1" iati-activities:version="2.01" xml:lang="EN" xmlns:iati-activities="http://d-portal.org/xmlns/iati-activities"><iati-identifier>XI-IATI-EBRD-57074</iati-identifier><reporting-org ref="XI-IATI-EBRD" type="40"><narrative xml:lang="EN">European Bank for Reconstruction and Development</narrative></reporting-org><title><narrative xml:lang="EN">Compagnie Miniere du Bafing S.A</narrative></title><description type="1"><narrative xml:lang="EN">Provision of a senior corporate loan of USD 30 million to Polynickel West  Africa Holding B.V. (&quot;Polynickel&quot;) to convert its temporary bridge loan into a  long-term syndicated facility, used to finance the acquisition of a majority  stake in Compagnie Miniere du Bafing S.A. (&quot;CMB&quot;), a leading nickel mining  company in C&#xf4;te d&apos;Ivoire (the &quot;Project&quot;). The Project is sponsored by the  parent company, CoreX Holding B.V. (&quot;CoreX&quot; or &quot;Parent&quot;).  The EBRD loan forms part of a USD 180 million syndicated facility, provided  alongside FirstRand Bank Limited, acting through its Rand Merchant Bank (&quot;RMB&quot;)  division, Absa Bank Limited (&quot;Absa&quot;), Mauritius Commercial Bank Limited  (&quot;MCB&quot;), and Abu Dhabi Commercial Bank PJSC (&quot;ADCB&quot;).</narrative></description><participating-org ref="XI-IATI-EBRD" role="1" type="40"><narrative xml:lang="EN">European Bank for Reconstruction and Development</narrative></participating-org><participating-org role="4"><narrative xml:lang="EN">POLYNICKEL WEST AFRICA BV</narrative></participating-org><activity-status code="2"></activity-status><activity-date iso-date="2026-05-22" type="1"></activity-date><activity-date iso-date="2026-05-22" type="2"></activity-date><contact-info type="1"><organisation><narrative xml:lang="EN">European Bank for Reconstruction and Development</narra