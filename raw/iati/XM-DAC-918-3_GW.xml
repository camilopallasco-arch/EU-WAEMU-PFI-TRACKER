<iati-activity xmlns:dstore="http://d-portal.org/xmlns/dstore" dstore:dataset="eib-act" dstore:index="1175" default-currency="EUR" hierarchy="1" iati-activities:version="2.02" xml:lang="EN" xmlns:iati-activities="http://d-portal.org/xmlns/iati-activities"><iati-identifier>XM-DAC-918-3-20210433-93743</iati-identifier><reporting-org ref="XM-DAC-918-3" secondary-reporter="0" type="15"><narrative xml:lang="EN">European Investment Bank</narrative></reporting-org><title><narrative xml:lang="EN">GUINEA-BISSAU TAH-7 RESILIENT ROAD CORRIDOR</narrative></title><description><narrative xml:lang="EN">Rehabilitation and climate change resilience enhancement of the N2 highway between Safim and Mpack (115 km). The project corresponds to a section of the Dakar-Lagos Trans-African Highway corridor No.7 (TAH-7). The project includes widening of the existing road to accommodate hard shoulders and includes rehabilitation of two major and five minor bridges. The EIB loan will support road rehabilitation works on the approximately 65 km long section starting from PK45 close to village of d&apos;Antotinha to the M&apos;Pack border crossing.</narrative></description><participating-org ref="40-Multilateral" role="1"><narrative xml:lang="EN">EIB</narrative></participating-org><participating-org ref="10-Government" role="4" type="10"><narrative xml:lang="EN">REPUBLICA DA GUINE-BISSAU</narrative></participating-org><activity-status code="2"></activity-status><activity-date iso-date="2024-12-17" type="2"></activity-date><activity-date iso-date="2029-12-07" type="3"></activity-date><contact-info type="1"><organisation><narrative xml:lang="EN">European Investment Bank</narrative></organisation><telephone>(+352) 43 79 1</telephone><website>http://www.eib.org/infocentre/contact-form.htm</website><mailing-address><narrative xml:lang="EN">98-100, boulevard Konrad Adenauer, L-2950 Luxembourg</narrative></mailing-address></contact-info><recipient-country code="GW" percentage="100"></recipient-country><s