<iati-activity xmlns:dstore="http://d-portal.org/xmlns/dstore" dstore:dataset="ebrd-activity" dstore:index="2786" default-currency="EUR" hierarchy="1" iati-activities:version="2.01" xml:lang="EN" xmlns:iati-activities="http://d-portal.org/xmlns/iati-activities"><iati-identifier>XI-IATI-EBRD-57288</iati-identifier><reporting-org ref="XI-IATI-EBRD" type="40"><narrative xml:lang="EN">European Bank for Reconstruction and Development</narrative></reporting-org><title><narrative xml:lang="EN">Axian Telecom</narrative></title><description type="1"><narrative xml:lang="EN">Provision of a long-term loan in favour of Axian Telecom Holding and Management  PLC (&quot;Axian Telecom&quot;, the &quot;Company&quot;, &quot;Group&quot;), a pan-African integrated  telecommunications operator. The loan is composed of two tranches (i) one  committed tranche to finance the capital expenditures of Axian Telecom in  Senegal and Kenya, supporting the modernisation and expansion of its mobile and  fixed networks, and (ii) one uncommitted tranche for future organic and  inorganic expansions in Africa.</narrative></description><participating-org role="4"><narrative xml:lang="EN">AXIAN TELECOM HOLDING AND MANAGEMENT PLC</narrative></participating-org><participating-org ref="XI-IATI-EBRD" role="1" type="40"><narrative xml:lang="EN">European Bank for Reconstruction and Development</narrative></participating-org><activity-status code="2"></activity-status><activity-date iso-date="2026-07-09" type="1"></activity-date><activity-date iso-date="2026-07-09" type="2"></activity-date><contact-info type="1"><organisation><narrative xml:lang="EN">European Bank for Reconstruction and Development</narrative></organisation><telephone>+44 20 7338 7380</telephone><email>projectenquiries@ebrd.com</email><website>www.ebrd.com</website><mailing-address><narrative xml:lang="EN">1 Exchange Square, London, EC2A 2JN</narrative></mailing-address></contact-info><activity-scope code="3"></activity-scope><recipient-countr