<iati-activity xmlns:dstore="http://d-portal.org/xmlns/dstore" dstore:dataset="eib-act" dstore:index="456" default-currency="EUR" hierarchy="1" iati-activities:version="2.02" xml:lang="EN" xmlns:iati-activities="http://d-portal.org/xmlns/iati-activities"><iati-identifier>XM-DAC-918-3-20150740-85464</iati-identifier><reporting-org ref="XM-DAC-918-3" secondary-reporter="0" type="15"><narrative xml:lang="EN">European Investment Bank</narrative></reporting-org><title><narrative xml:lang="EN">RURAL TELECOM NETWORK EXPANSION</narrative></title><description><narrative xml:lang="EN">The project consists of the purchase and installation of mobile telecom networks to extend the reach of telecommunication services to rural communities of the Democratic Republic of Congo (DRC) and Cameroon currently not served by any operator. The project is to be implemented from 2016 to 2018. Services will operate using the frequency bands awarded to established operators under revenue share agreements. By the end of 2018 the two networks are planned to provide coverage to over 3.6 m people based on 650 sites. The project will extend mobile telecommunication network population coverage from 75% to 80% in the DRC and from 85% to 95% in Cameroon. It includes investment in the core, access, transmission components and energy equipment.</narrative></description><participating-org ref="70-Private Sector" role="4" type="70"><narrative xml:lang="EN">AFRICA MOBILE NETWORKS LTD</narrative></participating-org><participating-org ref="40-Multilateral" role="1"><narrative xml:lang="EN">EDF</narrative></participating-org><participating-org ref="40-Multilateral" role="3" type="40"><narrative xml:lang="EN">EIB</narrative></participating-org><activity-status code="5"></activity-status><activity-date iso-date="2016-12-21" type="2"></activity-date><contact-info type="1"><organisation><narrative xml:lang="EN">European Investment Bank</narrative></organisation><telephone>(+352) 43 79 1</telephone><website>http://